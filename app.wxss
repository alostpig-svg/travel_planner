page {
  background:
    radial-gradient(circle at top left, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0) 28%),
    linear-gradient(180deg, #f5f5f7 0%, #eceef3 100%);
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Segoe UI", sans-serif;
}

.page-shell {
  padding: 32rpx 28rpx 52rpx;
}

.section {
  margin-top: 24rpx;
}

.card {
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 32rpx;
  padding: 30rpx;
  box-shadow:
    0 20rpx 60rpx rgba(17, 24, 39, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
}

.title-xl {
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.08;
  letter-spacing: -1rpx;
}

.title-lg {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.18;
  letter-spacing: -0.5rpx;
}

.muted {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.58;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.055);
  color: #4b5563;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid rgba(17, 24, 39, 0.06);
}

.chip.dark {
  background: linear-gradient(180deg, #20242d 0%, #10131a 100%);
  color: #fff;
  border-color: rgba(17, 24, 39, 0.7);
}

.chip.green {
  background: rgba(29, 185, 84, 0.12);
  color: #166534;
  border-color: rgba(29, 185, 84, 0.12);
}

.chip.red {
  background: rgba(255, 115, 85, 0.12);
  color: #b42318;
  border-color: rgba(255, 115, 85, 0.12);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 0 28rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #1f2937 0%, #101828 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.2rpx;
  box-shadow: 0 18rpx 40rpx rgba(17, 24, 39, 0.16);
}

.btn.secondary {
  background: rgba(255, 255, 255, 0.7);
  color: #111827;
  border: 1rpx solid rgba(17, 24, 39, 0.08);
  box-shadow: none;
}

.divider {
  height: 1rpx;
  background: rgba(17, 24, 39, 0.06);
  margin: 24rpx 0;
}
