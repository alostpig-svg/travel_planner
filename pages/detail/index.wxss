.detail-page {
  padding-top: 24rpx;
}

.detail-hero {
  overflow: hidden;
}

.detail-top {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 18rpx;
}

.detail-copy {
  min-width: 0;
}

.detail-subtitle {
  margin-top: 12rpx;
}

.score {
  min-width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #20242d 0%, #10131a 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 26rpx;
  box-shadow: 0 14rpx 28rpx rgba(17, 24, 39, 0.18);
}

.detail-chip-row,
.decision-chip-row,
.tag-row,
.decision-alt-row {
  margin-top: 16rpx;
}

.section-copy {
  margin-top: 10rpx;
}

.decision-row {
  margin-top: 20rpx;
}

.decision-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 8rpx;
}

.info-list {
  margin-top: 14rpx;
}

.info-row {
  display: grid;
  grid-template-columns: 160rpx 1fr;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(17, 24, 39, 0.05);
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  font-size: 22rpx;
  color: #8a92a0;
}

.info-value {
  font-size: 24rpx;
  color: #111827;
  line-height: 1.6;
}
