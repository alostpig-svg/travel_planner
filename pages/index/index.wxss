.home-page {
  padding-top: 24rpx;
}

.hero-panel {
  padding: 16rpx 8rpx 10rpx;
}

.hero-topline {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #8b93a1;
}

.hero-title-wrap {
  margin-top: 18rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(17, 24, 39, 0.06);
  color: #111827;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(17, 24, 39, 0.06);
}

.hero-copy {
  margin-top: 18rpx;
  max-width: 620rpx;
  font-size: 26rpx;
  line-height: 1.72;
  color: #6b7280;
}

.hero-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.metric-card {
  padding: 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 34rpx rgba(17, 24, 39, 0.06);
}

.metric-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.metric-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a92a0;
}

.generator-card {
  overflow: hidden;
}

.section-head {
  margin-top: 10rpx;
  gap: 20rpx;
  align-items: flex-end;
}

.compact-head {
  margin-top: 0;
}

.mode-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 22rpx;
}

.mode-card {
  padding: 26rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(17, 24, 39, 0.06);
  background: rgba(247, 248, 251, 0.76);
}

.mode-card.active.relaxed {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(244, 246, 250, 0.92) 100%);
  box-shadow: 0 18rpx 40rpx rgba(17, 24, 39, 0.08);
}

.mode-card.active.hardcore {
  background: linear-gradient(180deg, #252a33 0%, #141821 100%);
  border-color: rgba(17, 24, 39, 0.5);
  box-shadow: 0 18rpx 44rpx rgba(17, 24, 39, 0.22);
}

.mode-card.active.hardcore .mode-title,
.mode-card.active.hardcore .mode-copy {
  color: #fff;
}

.mode-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.mode-copy {
  min-height: 72rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b7280;
}

.chip-row {
  margin-top: 18rpx;
}

.chip.light {
  background: rgba(255, 255, 255, 0.14);
  border-color: rgba(255, 255, 255, 0.14);
  color: #fff;
}

.control-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 18rpx;
}

.focus-box,
.control-box {
  padding: 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(17, 24, 39, 0.05);
}

.mini-label,
.focus-label {
  color: #8a92a0;
  font-size: 22rpx;
}

.mini-value,
.focus-value {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.4;
}

.focus-value.small {
  font-size: 24rpx;
}

.pref-block {
  margin-top: 20rpx;
}

.pref-row {
  margin-top: 14rpx;
}

.generate-btn {
  margin-top: 22rpx;
}

.city-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
}

.city-card {
  padding: 26rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(17, 24, 39, 0.05);
  box-shadow: 0 14rpx 30rpx rgba(17, 24, 39, 0.05);
}

.city-card.active {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(245, 247, 250, 0.92) 100%);
  border-color: rgba(17, 24, 39, 0.12);
  box-shadow: 0 18rpx 44rpx rgba(17, 24, 39, 0.1);
}

.city-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.city-tags {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a92a0;
  line-height: 1.5;
}

.item-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.3;
}

.preview-card {
  padding-bottom: 18rpx;
}

.preview-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.preview-badge {
  padding: 14rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(17, 24, 39, 0.06);
  color: #111827;
  font-size: 24rpx;
  font-weight: 700;
}

.preview-stat {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(246, 247, 250, 0.82);
  border: 1rpx solid rgba(17, 24, 39, 0.04);
}

.day-preview {
  padding: 16rpx 0;
}

.day-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #111827;
}

.day-area {
  font-size: 22rpx;
  color: #8a92a0;
  text-align: right;
}

.day-route {
  margin-top: 8rpx;
}
