.home-page {
  padding-top: 24rpx;
}

.hero-panel {
  padding: 16rpx 8rpx 10rpx;
}

.hero-topline {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #8b93a1;
}

.hero-title-wrap {
  margin-top: 18rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(17, 24, 39, 0.06);
  color: #111827;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(17, 24, 39, 0.06);
}

.hero-copy {
  margin-top: 18rpx;
  max-width: 620rpx;
  font-size: 26rpx;
  line-height: 1.72;
  color: #6b7280;
}

.hero-metrics {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 16rpx;
  margin-top: 28rpx;
  align-items: stretch;
}

.metric-card {
  padding: 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 34rpx rgba(17, 24, 39, 0.06);
}

.metric-card:not(.metric-map-card) {
  display: flex;
  flex-direction: column;
  min-height: 360rpx;
}

.metric-info-card {
  padding: 0;
  min-height: 360rpx;
  height: 360rpx;
  justify-content: stretch;
  overflow: hidden;
}

.metric-info-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: 20rpx 22rpx;
}

.metric-value {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.metric-label {
  font-size: 22rpx;
  color: #8a92a0;
  letter-spacing: 1rpx;
}

.metric-meta {
  margin-top: 12rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #6b7280;
}

.metric-map-card {
  position: relative;
  padding: 0;
  overflow: hidden;
  height: 360rpx;
  align-self: stretch;
}

.metric-map-head {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 0;
  z-index: 2;
  pointer-events: none;
}

.metric-map-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  text-shadow: 0 4rpx 12rpx rgba(17, 24, 39, 0.28);
}

.metric-map-subtitle {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.82);
  text-shadow: 0 4rpx 12rpx rgba(17, 24, 39, 0.28);
}

.metric-map {
  width: 100%;
  height: 100%;
  display: block;
}

.metric-divider {
  height: 1rpx;
  margin: 0 22rpx;
  background: rgba(17, 24, 39, 0.08);
}

.generator-card {
  overflow: hidden;
  padding: 20rpx;
}

.section-head {
  margin-top: 10rpx;
  gap: 20rpx;
  align-items: flex-end;
}

.compact-head {
  margin-top: 0;
}

.planner-minimal {
  margin-top: 14rpx;
  padding: 16rpx 4rpx 4rpx;
}

.planner-block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 14rpx;
}

.planner-block-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #111827;
}

.planner-block-note {
  font-size: 20rpx;
  color: #8a92a0;
  letter-spacing: 1rpx;
}

.mode-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 16rpx;
}

.mode-grid.minimal {
  gap: 12rpx;
  margin-top: 12rpx;
}

.mode-card {
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(17, 24, 39, 0.06);
  background: rgba(247, 248, 251, 0.76);
  transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease, background 180ms ease;
}

.mode-card.active {
  border-color: rgba(17, 24, 39, 0.16);
  box-shadow: 0 18rpx 42rpx rgba(17, 24, 39, 0.12);
  transform: translateY(-2rpx);
}

.mode-card.active.relaxed {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.99) 0%, rgba(243, 245, 249, 0.96) 100%);
}

.mode-card.active.hardcore {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.99) 0%, rgba(241, 245, 247, 0.96) 100%);
  border-color: rgba(17, 24, 39, 0.16);
  box-shadow: 0 18rpx 42rpx rgba(17, 24, 39, 0.12);
}

.mode-card.active.hardcore .mode-title,
.mode-card.active.hardcore .mode-card-tag {
  color: #111827;
}

.mode-card.active.hardcore .mode-card-tag {
  color: #8a92a0;
}

.mode-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #111827;
}

.mode-card-tag {
  margin-bottom: 8rpx;
  font-size: 18rpx;
  color: #8a92a0;
  line-height: 1.3;
}

.chip-row {
  margin-top: 18rpx;
}

.chip.light {
  background: rgba(255, 255, 255, 0.14);
  border-color: rgba(255, 255, 255, 0.14);
  color: #fff;
}

.days-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10rpx;
  margin-top: 12rpx;
}

.day-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 66rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background: rgba(248, 249, 252, 0.92);
  border: 1rpx solid rgba(17, 24, 39, 0.05);
  color: #111827;
  font-size: 22rpx;
  font-weight: 600;
  transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease, background 180ms ease;
}

.day-chip.active {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.99) 0%, rgba(243, 245, 249, 0.96) 100%);
  border-color: rgba(17, 24, 39, 0.16);
  box-shadow: 0 12rpx 30rpx rgba(17, 24, 39, 0.12);
  transform: translateY(-2rpx);
  font-weight: 700;
}

.focus-box,
.control-box {
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(248, 249, 252, 0.92);
  border: 1rpx solid rgba(17, 24, 39, 0.05);
}

.mini-value,
.focus-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.4;
}

.focus-value.small {
  font-size: 24rpx;
}

.generate-btn {
  margin-top: 16rpx;
}

.generate-btn.minimal {
  margin-top: 16rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 20rpx;
}

.city-picker-shell {
  margin-top: 8rpx;
}

.city-swiper {
  height: 132rpx;
}

.city-focus-card {
  position: relative;
  height: 112rpx;
  margin: 20rpx 10rpx 8rpx;
  padding: 16rpx 18rpx 14rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.54);
  border: 1rpx solid rgba(17, 24, 39, 0.05);
  box-shadow: 0 8rpx 18rpx rgba(17, 24, 39, 0.03);
  transform: scale(0.84);
  transform-origin: center center;
  opacity: 0.42;
  transition: transform 220ms ease, opacity 220ms ease, box-shadow 220ms ease, background 220ms ease;
}

.city-focus-card.active {
  height: 128rpx;
  margin-top: 0;
  margin-bottom: 6rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(246, 248, 251, 0.94) 100%);
  border-color: rgba(17, 24, 39, 0.1);
  box-shadow: 0 18rpx 38rpx rgba(17, 24, 39, 0.11);
  transform: scale(1);
  opacity: 1;
}

.city-focus-card.active[data-index="1"] {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.99) 0%, rgba(246, 243, 238, 0.96) 100%);
}

.city-focus-cover,
.city-focus-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border-radius: 26rpx;
}

.city-focus-cover {
  opacity: 0.34;
}

.city-focus-overlay {
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0.74) 45%, rgba(255, 255, 255, 0.34) 100%);
}

.city-focus-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.city-focus-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #111827;
}

.city-focus-copy {
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
  max-width: 420rpx;
  font-size: 19rpx;
  line-height: 1.45;
  color: #5f6773;
}

.city-focus-tags {
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
  font-size: 18rpx;
  color: #7c8491;
  line-height: 1.4;
}

.city-focus-card.active[data-index="1"] .city-focus-copy {
  color: #6a5438;
}

.city-focus-card.active[data-index="1"] .city-focus-tags {
  color: #8d6b48;
}

.city-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin-top: 0;
}

.discovery-card {
  overflow: hidden;
  padding: 12rpx;
}

.discovery-board {
  margin-top: 6rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
}

.discovery-mini-card {
  position: relative;
  min-height: 204rpx;
  padding: 8rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(245, 247, 250, 0.98) 0%, rgba(238, 242, 247, 0.96) 100%);
  border: 1rpx solid rgba(17, 24, 39, 0.06);
  box-shadow: 0 18rpx 36rpx rgba(17, 24, 39, 0.08);
}

.watch-stage {
  position: relative;
  width: 100%;
  height: 188rpx;
  overflow: hidden;
}

.watch-node {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: transform 360ms cubic-bezier(0.22, 1, 0.36, 1), opacity 240ms ease;
  will-change: transform, opacity;
}

.watch-node-bubble {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f3f4f6;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 10rpx 18rpx rgba(17, 24, 39, 0.1);
  transition: width 360ms cubic-bezier(0.22, 1, 0.36, 1), height 360ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 280ms ease;
}

.watch-node.active .watch-node-bubble {
  width: 108rpx;
  height: 108rpx;
  box-shadow: 0 16rpx 28rpx rgba(17, 24, 39, 0.16);
}

.watch-node-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.watch-node-overlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0) 48%), linear-gradient(180deg, rgba(17, 24, 39, 0.04) 0%, rgba(17, 24, 39, 0.34) 100%);
}

.watch-node-label {
  text-align: center;
  transform: translateY(0);
  max-width: 180rpx;
  margin-top: 2rpx;
}

.watch-node-label.active {
  opacity: 1;
  transform: translateY(0);
}

.watch-node-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.2;
}

.watch-node-center {
  left: 50%;
  top: 50%;
  transform: translate(-50%, -52%);
  z-index: 4;
}

.watch-node-ring-a {
  left: 8rpx;
  top: 18rpx;
  transform: translate(0, 0);
  z-index: 2;
}

.watch-node-ring-b {
  right: 10rpx;
  top: 12rpx;
  transform: translate(0, 0);
  z-index: 2;
}

.watch-node-ring-c {
  left: 50%;
  bottom: 0;
  transform: translate(-50%, 0);
  z-index: 1;
}

.watch-node:not(.active) .watch-node-bubble {
  opacity: 0.7;
  transform: scale(0.92);
}

.watch-node.active {
  z-index: 5;
}

.watch-node.active .watch-node-bubble {
  transform: scale(1);
}

.spot-card {
  background: linear-gradient(180deg, rgba(246, 248, 251, 0.98) 0%, rgba(239, 243, 248, 0.96) 100%);
}

.food-card {
  background: linear-gradient(180deg, rgba(250, 247, 243, 0.98) 0%, rgba(243, 238, 232, 0.96) 100%);
}

.city-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.14);
  transition: width 220ms ease, background 220ms ease;
}

.city-dot.active {
  width: 18rpx;
  background: rgba(17, 24, 39, 0.72);
}
