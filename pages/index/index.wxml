<view class="page-shell home-page">
  <view class="hero-panel">
    <view class="hero-topline">REAL TRAVEL, QUIETLY DESIGNED</view>
    <view class="hero-title-wrap">
      <view class="title-xl">Travel Planner</view>
      <view class="hero-badge">Curated Routes</view>
    </view>
    <view class="hero-copy">Turn city research into a route you can actually follow.</view>
    <view class="hero-metrics">
      <view class="metric-card metric-map-card">
        <view class="metric-map-head">
          <view class="metric-map-title">Map Preview</view>
          <view class="metric-map-subtitle">{{cityMapPreview.subtitle}}</view>
        </view>
        <map
          class="metric-map"
          latitude="{{cityMapPreview.latitude}}"
          longitude="{{cityMapPreview.longitude}}"
          scale="{{cityMapPreview.scale}}"
          markers="{{cityMapPreview.markers}}"
          show-location="{{false}}"
          enable-scroll="{{false}}"
          enable-zoom="{{false}}"
          enable-rotate="{{false}}"
          enable-overlooking="{{false}}"
          show-compass="{{false}}"
          show-scale="{{false}}"
        />
      </view>
      <view class="metric-card metric-info-card">
        <view class="metric-info-section">
          <view class="metric-label">City</view>
          <view class="metric-value">{{destinations[destinationIndex].name}}</view>
          <view class="metric-meta">{{destinations[destinationIndex].intro}}</view>
        </view>
        <view class="metric-divider"></view>
        <view class="metric-info-section">
          <view class="metric-label">Mode</view>
          <view class="metric-value">{{selectedMode === 'relaxed' ? 'Relaxed' : 'Fast'}}</view>
          <view class="metric-meta">{{selectedMode === 'relaxed' ? 'Less rushing, more staying.' : 'Higher coverage, tighter flow.'}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="row section-head compact-head">
      <view class="title-lg">Cities</view>
      <view class="muted">Swipe to choose</view>
    </view>
    <view class="city-picker-shell">
      <swiper
        class="city-swiper"
        current="{{destinationIndex}}"
        previous-margin="168rpx"
        next-margin="168rpx"
        circular="{{true}}"
        skip-hidden-item-layout="{{true}}"
        bindchange="onCitySwiperChange"
      >
        <block wx:for="{{destinations}}" wx:key="id">
          <swiper-item>
            <view class="city-focus-card {{destinationIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onSelectDestination">
              <image class="city-focus-cover" src="{{item.cardCover}}" mode="aspectFill" />
              <view class="city-focus-overlay"></view>
              <view class="city-focus-top">
                <view class="city-focus-name">{{item.name}}</view>
              </view>
              <view class="city-focus-copy">{{item.intro}}</view>
              <view class="city-focus-tags">{{item.statusTags.join(' · ')}}</view>
            </view>
          </swiper-item>
        </block>
      </swiper>
      <view class="city-dots">
        <block wx:for="{{destinations}}" wx:key="id">
          <view class="city-dot {{destinationIndex === index ? 'active' : ''}}"></view>
        </block>
      </view>
    </view>
  </view>

  <view class="section card generator-card">
    <view class="row section-head compact-head">
      <view class="title-lg">Build Route</view>
      <view class="muted">Mode and days</view>
    </view>

    <view class="planner-minimal">
      <view class="planner-block-head">
        <view class="planner-block-title">Mode</view>
      </view>

      <view class="mode-grid minimal">
        <view class="mode-card {{selectedMode === 'relaxed' ? 'active relaxed' : ''}}" data-mode="relaxed" bindtap="onModeChange">
          <view class="mode-card-tag">Recommended for slower trips</view>
          <view class="mode-title">Relaxed</view>
        </view>
        <view class="mode-card {{selectedMode === 'hardcore' ? 'active hardcore' : ''}}" data-mode="hardcore" bindtap="onModeChange">
          <view class="mode-card-tag">For tighter schedules</view>
          <view class="mode-title">Fast</view>
        </view>
      </view>

      <view class="planner-block-head">
        <view class="planner-block-title">Days</view>
      </view>

      <view class="days-grid">
        <view class="day-chip {{days === 1 ? 'active' : ''}}" data-days="1" bindtap="onDaysSelect">1 day</view>
        <view class="day-chip {{days === 2 ? 'active' : ''}}" data-days="2" bindtap="onDaysSelect">2 days</view>
        <view class="day-chip {{days === 3 ? 'active' : ''}}" data-days="3" bindtap="onDaysSelect">3 days</view>
        <view class="day-chip {{days === 4 ? 'active' : ''}}" data-days="4" bindtap="onDaysSelect">4 days</view>
        <view class="day-chip {{days === 5 ? 'active' : ''}}" data-days="5" bindtap="onDaysSelect">5 days</view>
      </view>

      <view class="btn generate-btn minimal" bindtap="goRoute">Generate Route</view>
    </view>
  </view>
</view>
