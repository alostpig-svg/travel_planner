.destination-page {
  padding-top: 24rpx;
}

.hero-card {
  overflow: hidden;
}

.hero-kicker {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  color: #9098a6;
}

.hero-copy {
  margin-top: 14rpx;
}

.city-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
}

.city-card {
  padding: 26rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(17, 24, 39, 0.05);
  box-shadow: 0 14rpx 30rpx rgba(17, 24, 39, 0.05);
}

.city-card.active {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(245, 247, 250, 0.92) 100%);
  border-color: rgba(17, 24, 39, 0.12);
  box-shadow: 0 18rpx 44rpx rgba(17, 24, 39, 0.1);
}

.city-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.city-copy {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.58;
  color: #8a92a0;
}

.city-chip-row,
.item-chip-row {
  margin-top: 14rpx;
}

.strategy-card {
  overflow: hidden;
}

.strategy-grid,
.decision-grid {
  display: grid;
  gap: 14rpx;
  margin-top: 18rpx;
}

.strategy-item,
.decision-card {
  padding: 20rpx 20rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(17, 24, 39, 0.05);
}

.strategy-label {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: #9ca3af;
}

.strategy-value,
.decision-summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.58;
  color: #111827;
}

.decision-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #111827;
}

.decision-tags {
  margin-top: 14rpx;
}

.filter-card {
  overflow: hidden;
}

.section-row {
  align-items: flex-end;
}

.filter-row {
  margin-top: 16rpx;
}

.list {
  display: grid;
  gap: 16rpx;
  margin-top: 18rpx;
}

.item-card {
  margin-top: 0;
}

.item-top {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 18rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #111827;
}

.score {
  min-width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #20242d 0%, #10131a 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 26rpx;
  box-shadow: 0 14rpx 28rpx rgba(17, 24, 39, 0.18);
}
