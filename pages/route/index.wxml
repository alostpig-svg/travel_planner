<view class="page-shell route-page">
  <view class="hero-card {{mode}}">
    <view class="hero-topline">
      <view class="hero-title">路线生成器</view>
      <view class="hero-badge">{{mode === 'relaxed' ? '松弛游' : '特种兵'}}</view>
    </view>

    <view class="config-strip">
      <view class="config-card compact">
        <view class="mini-label">目的地</view>
        <picker mode="selector" range="{{destinations}}" bindchange="onDestinationChange">
          <view class="mini-value">{{destination}}</view>
        </picker>
      </view>
      <view class="config-card compact">
        <view class="mini-label">天数</view>
        <picker mode="selector" range="{{['1天','2天','3天','4天','5天']}}" bindchange="onDaysChange">
          <view class="mini-value">{{days}} 天</view>
        </picker>
      </view>
      <view class="config-card compact mode-card">
        <view class="mini-label">模式</view>
        <view class="mode-switch">
          <view class="mode-pill {{mode === 'relaxed' ? 'active' : ''}}" data-mode="relaxed" bindtap="onModeTap">松弛游</view>
          <view class="mode-pill {{mode === 'hardcore' ? 'active' : ''}}" data-mode="hardcore" bindtap="onModeTap">特种兵</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section card map-panel" wx:if="{{route}}">
    <view class="row section-row">
      <view class="title-lg">地图路线</view>
      <view class="muted">按天查看动线</view>
    </view>

    <view class="day-switcher">
      <block wx:for="{{route.dayPlans}}" wx:key="dayNumber">
        <view class="day-pill {{currentDayIndex === index ? 'active ' + mode : ''}}" data-index="{{index}}" bindtap="onDayMapChange">
          Day {{item.dayNumber}}
        </view>
      </block>
    </view>

    <view wx:if="{{dayMap && dayMap.center}}" class="map-wrap">
      <view wx:if="{{!showRoutePolyline}}" class="map-hint">
        放大到 {{routeRevealScale}} 级后显示路线
      </view>

      <map
        class="route-map"
        latitude="{{dayMap.center.latitude}}"
        longitude="{{dayMap.center.longitude}}"
        scale="{{mapScale}}"
        markers="{{dayMap.markers}}"
        polyline="{{showRoutePolyline ? dayMap.polylines : []}}"
        show-location="false"
        enable-zoom="true"
        bindregionchange="onRouteMapRegionChange"
      ></map>

      <view class="map-path {{showRoutePolyline ? 'map-path-visible' : 'map-path-muted'}}">
        <block wx:for="{{dayMap.pathNames}}" wx:key="index">
          <view class="path-chip">
            <text class="path-index" style="background: {{item.color}};">{{item.sequence}}</text>
            <view class="path-main">
              <text class="path-title">{{item.title}}</text>
              <text class="path-type">{{item.label}}</text>
            </view>
          </view>
        </block>
      </view>
    </view>

    <empty-state wx:else text="当前这一天还没有可展示的坐标点位"></empty-state>
  </view>

  <view class="section" wx:if="{{currentDayPlan}}">
    <view class="card day-card">
      <view class="row day-head">
        <view class="day-head-copy">
          <view class="title-lg">Day {{currentDayPlan.dayNumber}} · {{currentDayPlan.dayTitle}}</view>
          <view class="muted">{{currentDayPlan.area}} · {{currentDayPlan.trafficSummary}}</view>
          <view wx:if="{{currentDayPlan.stayMeta}}" class="muted">{{currentDayPlan.stayMeta.stayTransition}}</view>
        </view>
        <view class="day-duration {{mode}}">{{currentDayPlan.totalDuration}}</view>
      </view>

      <view wx:if="{{dayMap && dayMap.legend}}" class="route-legend">
        <block wx:for="{{dayMap.legend}}" wx:key="label">
          <view class="route-legend-item">
            <view class="legend-dot" style="background: {{item.color}};"></view>
            <text class="legend-text">{{item.label}}</text>
          </view>
        </block>
      </view>

      <view class="divider"></view>

      <block wx:for="{{currentDayPlan.items}}" wx:key="index">
        <view class="timeline {{index < currentRouteStepIndex ? 'done' : index === currentRouteStepIndex ? 'current' : 'todo'}} {{mode}}">
          <view class="timeline-time">
            <view class="timeline-time-row">
              <view class="timeline-time-text">{{item.startTime}} - {{item.endTime}}</view>
              <view wx:if="{{item.latitude && item.longitude}}" class="timeline-tip">实时提示</view>
            </view>
            <view wx:if="{{item.routeSketch}}" class="timeline-sketch {{item.progressState}} {{item.placeType}}">
              <view class="sketch-canvas" style="width: {{item.routeSketch.width}}rpx; height: {{item.routeSketch.height}}rpx;">
                <view class="sketch-paper"></view>
                <block wx:for="{{item.routeSketch.segments}}" wx:key="index">
                  <view class="sketch-segment {{item.state}}" style="{{item.style}}"></view>
                </block>
                <block wx:for="{{item.routeSketch.bends}}" wx:key="index">
                  <view class="sketch-bend {{item.state}}" style="{{item.style}}"></view>
                </block>
                <block wx:for="{{item.routeSketch.points}}" wx:key="sequence">
                  <view class="sketch-point {{item.state}} {{item.placeType}}" style="left: {{item.x}}rpx; top: {{item.y}}rpx;">
                    <text class="sketch-point-num">{{item.sequence}}</text>
                  </view>
                </block>
              </view>
            </view>
          </view>
          <view class="timeline-main">
            <view class="timeline-dot {{item.placeType}}"></view>
            <view class="timeline-title">{{item.placeName}}</view>
            <view class="muted">{{item.action}}</view>
            <view class="muted timeline-reason">{{item.reason}}</view>
            <view class="timeline-chips">
              <view class="chip">{{item.updatedAt}}</view>
              <view class="chip red">{{item.tips}}</view>
              <view wx:if="{{item.placeType === 'food'}}" class="chip green">吃饭补给</view>
              <view wx:if="{{item.placeType === 'spot' && mode === 'hardcore'}}" class="chip">高效覆盖</view>
              <view wx:if="{{item.placeType === 'spot' && mode === 'relaxed'}}" class="chip">慢慢停留</view>
              <view wx:if="{{item.placeType === 'hotel'}}" class="chip hotel-chip">今晚住宿</view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="section card stay-panel" wx:if="{{route && route.stayPlan}}">
    <view class="row section-row">
      <view class="title-lg">{{route.stayPlan.title}}</view>
      <view class="muted">住宿已纳入路线</view>
    </view>
    <view class="muted panel-copy">{{route.stayPlan.summary}}</view>
    <view wx:if="{{route.stayPlan.nightStrategy}}" class="muted">{{route.stayPlan.nightStrategy}}</view>

    <view class="stay-list">
      <block wx:for="{{route.stayPlan.items}}" wx:key="id">
        <view class="stay-card">
          <view class="row">
            <view>
              <view class="item-title">{{item.name}}</view>
              <view class="muted">{{item.area}} · {{item.stayStyle}}</view>
            </view>
          </view>
          <view class="muted stay-copy">{{item.decision}}</view>
          <view class="stay-chip-row">
            <view class="chip">{{item.routeRole}}</view>
            <view class="chip">{{item.qualityLabel}}</view>
            <view class="chip">{{item.sourcePlatform.join(' / ')}}</view>
          </view>
        </view>
      </block>
    </view>

    <view wx:if="{{route.stayPlan.assignments && route.stayPlan.assignments.length}}" class="assignment-row">
      <block wx:for="{{route.stayPlan.assignments}}" wx:key="dayNumber">
        <view class="chip {{item.isSwitchNight ? 'hotel-chip' : ''}}">{{item.transitionText}}</view>
      </block>
    </view>
  </view>

  <view class="section">
    <view class="btn" bindtap="onSaveRoute">保存路线</view>
  </view>
</view>
