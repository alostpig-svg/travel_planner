.route-page {
  padding-top: 24rpx;
}

.hero-card {
  border-radius: 28rpx;
  padding: 14rpx 14rpx 12rpx;
  box-shadow: 0 16rpx 34rpx rgba(17, 24, 39, 0.06);
  overflow: hidden;
}

.hero-card.relaxed {
  background:
    radial-gradient(circle at top right, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0) 26%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, rgba(242, 245, 249, 0.97) 100%);
}

.hero-card.hardcore {
  background:
    radial-gradient(circle at top right, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0) 22%),
    linear-gradient(180deg, #272d37 0%, #171b23 100%);
}

.hero-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.hero-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #111827;
  letter-spacing: 0.4rpx;
}

.hero-badge {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.05);
  color: #4b5563;
  font-size: 18rpx;
  font-weight: 700;
}

.hero-card.hardcore .hero-title,
.hero-card.hardcore .mini-label,
.hero-card.hardcore .mini-value {
  color: #fff;
}

.hero-card.hardcore .hero-badge {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.88);
}

.config-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rpx;
  overflow: hidden;
  border-radius: 22rpx;
  padding: 1rpx;
  background: rgba(17, 24, 39, 0.06);
}

.hero-card.hardcore .config-strip {
  background: rgba(255, 255, 255, 0.08);
}

.config-card {
  padding: 12rpx 12rpx 10rpx;
  min-height: 72rpx;
  background: rgba(255, 255, 255, 0.62);
}

.hero-card.hardcore .config-card {
  background: rgba(255, 255, 255, 0.06);
}

.compact {
  min-width: 0;
}

.mini-label {
  font-size: 14rpx;
  color: #8b93a4;
  letter-spacing: 1rpx;
  margin-bottom: 6rpx;
}

.mini-value {
  font-size: 24rpx;
  line-height: 1.2;
  color: #111827;
  font-weight: 800;
}

.mode-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.mode-switch {
  display: inline-flex;
  gap: 8rpx;
  width: 100%;
  padding: 4rpx;
  margin-top: 2rpx;
  border-radius: 16rpx;
  background: rgba(17, 24, 39, 0.04);
}

.hero-card.hardcore .mode-switch {
  background: rgba(255, 255, 255, 0.08);
}

.mode-pill {
  flex: 1;
  min-width: 0;
  padding: 10rpx 10rpx;
  border-radius: 12rpx;
  text-align: center;
  color: #667085;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0.2rpx;
  background: transparent;
}

.mode-pill.active {
  background: rgba(255, 255, 255, 0.96);
  color: #111827;
  box-shadow: 0 8rpx 18rpx rgba(17, 24, 39, 0.08);
}

.hero-card.hardcore .mode-pill.active {
  background: rgba(255, 255, 255, 0.92);
  color: #111827;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.06);
}

.chip.light {
  background: rgba(255, 255, 255, 0.14);
  border-color: rgba(255, 255, 255, 0.12);
  color: #fff;
}

.stay-panel,
.map-panel {
  overflow: hidden;
}

.stay-chip-row,
.assignment-row,
.timeline-chips {
  margin-top: 14rpx;
}

.section-row {
  align-items: flex-end;
}

.stay-list {
  display: grid;
  gap: 16rpx;
  margin-top: 18rpx;
}

.stay-card {
  padding: 22rpx;
  border-radius: 26rpx;
  background: rgba(246, 247, 250, 0.84);
  border: 1rpx solid rgba(17, 24, 39, 0.04);
}

.stay-copy {
  margin-top: 10rpx;
}

.hotel-chip {
  background: rgba(109, 40, 217, 0.11);
  color: #6d28d9;
  border-color: rgba(109, 40, 217, 0.08);
}

.day-switcher {
  display: flex;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 6rpx;
  border-radius: 20rpx;
  background: rgba(17, 24, 39, 0.04);
  overflow-x: auto;
  flex-wrap: nowrap;
}

.day-pill {
  flex: 0 0 auto;
  padding: 12rpx 18rpx;
  border-radius: 14rpx;
  background: transparent;
  color: #667085;
  font-size: 22rpx;
  font-weight: 700;
}

.day-pill.active.relaxed,
.day-pill.active.hardcore {
  background: rgba(255, 255, 255, 0.96);
  color: #111827;
  box-shadow: 0 8rpx 18rpx rgba(17, 24, 39, 0.08);
}

.map-wrap {
  margin-top: 16rpx;
  padding: 14rpx;
  border-radius: 26rpx;
  background: rgba(17, 24, 39, 0.03);
  border: 1rpx solid rgba(17, 24, 39, 0.05);
}

.map-legend {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.route-legend {
  display: flex;
  gap: 8rpx;
  flex-wrap: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  margin: 12rpx 0 4rpx;
  padding-bottom: 2rpx;
}

.route-legend-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  flex: 0 0 auto;
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.03);
  border: 1rpx solid rgba(17, 24, 39, 0.035);
}

.map-hint {
  margin-bottom: 12rpx;
  padding: 10rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 1rpx solid rgba(17, 24, 39, 0.05);
  color: #6b7280;
  font-size: 20rpx;
}

.legend-item {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 1rpx solid rgba(17, 24, 39, 0.04);
}

.legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
}

.legend-text {
  font-size: 18rpx;
  line-height: 1;
  color: #6b7280;
}

.route-map {
  width: 100%;
  height: 450rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.map-path {
  display: flex;
  flex-wrap: nowrap;
  gap: 10rpx;
  margin-top: 12rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 2rpx;
}

.map-path-visible {
  animation: routeFadeUp 260ms ease-out both;
}

.map-path-muted {
  opacity: 0.78;
}

.path-chip {
  display: inline-flex;
  align-items: flex-start;
  gap: 8rpx;
  min-width: 182rpx;
  padding: 10rpx 12rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(17, 24, 39, 0.05);
  box-shadow: 0 8rpx 18rpx rgba(17, 24, 39, 0.04);
  font-size: 18rpx;
}

.path-index {
  flex: 0 0 auto;
  width: 28rpx;
  height: 28rpx;
  border-radius: 999rpx;
  color: #fff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 700;
}

.path-main {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.path-title {
  font-size: 18rpx;
  line-height: 1.25;
  color: #111827;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.path-type {
  font-size: 16rpx;
  line-height: 1.2;
  color: #8a92a0;
  white-space: nowrap;
}

@keyframes routeFadeUp {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.day-card {
  margin-bottom: 16rpx;
}

.day-head {
  align-items: flex-start;
  gap: 18rpx;
}

.day-head-copy {
  flex: 1;
}

.day-duration {
  color: #6b7280;
  font-size: 24rpx;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.055);
  white-space: nowrap;
}

.day-duration.hardcore {
  background: linear-gradient(180deg, #20242d 0%, #10131a 100%);
  color: #fff;
}

.timeline {
  display: grid;
  grid-template-columns: 176rpx 1fr;
  gap: 14rpx;
  padding: 18rpx 0;
}

.timeline.done {
  opacity: 0.76;
}

.timeline.current {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.42), rgba(255, 255, 255, 0));
  border-radius: 24rpx;
}

.timeline.current .timeline-main {
  border-left-color: rgba(17, 24, 39, 0.2);
}

.timeline.current .timeline-dot {
  transform: scale(1.15);
  box-shadow: 0 0 0 8rpx rgba(255, 255, 255, 0.92);
}

.timeline.todo {
  opacity: 0.92;
}

.timeline-time {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-weight: 700;
  color: #374151;
}

.timeline-time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.timeline-time-text {
  font-size: 24rpx;
  line-height: 1.2;
}

.timeline-tip {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.06);
  color: #374151;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.timeline-sketch {
  position: relative;
  width: 150rpx;
  height: 108rpx;
  border-radius: 22rpx;
  background:
    radial-gradient(circle at 18% 18%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0) 42%),
    radial-gradient(circle at 84% 82%, rgba(255, 255, 255, 0.48), rgba(255, 255, 255, 0) 38%),
    linear-gradient(180deg, rgba(251, 249, 245, 0.98) 0%, rgba(245, 246, 249, 0.98) 100%);
  border: 1rpx solid rgba(17, 24, 39, 0.05);
  overflow: hidden;
  box-shadow: 0 10rpx 18rpx rgba(17, 24, 39, 0.04);
}

.timeline-sketch::before {
  content: '';
  position: absolute;
  inset: 10rpx;
  border-radius: 16rpx;
  background:
    radial-gradient(circle at 24% 26%, rgba(140, 150, 162, 0.14) 0 2.2rpx, transparent 3.2rpx),
    radial-gradient(circle at 58% 20%, rgba(140, 150, 162, 0.12) 0 2rpx, transparent 3rpx),
    radial-gradient(circle at 74% 62%, rgba(140, 150, 162, 0.1) 0 2rpx, transparent 3rpx),
    radial-gradient(circle at 42% 74%, rgba(140, 150, 162, 0.12) 0 2rpx, transparent 3rpx),
    linear-gradient(135deg, rgba(17, 24, 39, 0.03) 0%, rgba(17, 24, 39, 0.01) 100%);
}

.sketch-canvas {
  position: relative;
}

.sketch-paper {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0) 40%),
    radial-gradient(circle at 25% 20%, rgba(255, 227, 214, 0.22), rgba(255, 255, 255, 0) 24%),
    radial-gradient(circle at 80% 75%, rgba(226, 232, 240, 0.34), rgba(255, 255, 255, 0) 30%);
}

.sketch-segment {
  position: absolute;
  height: 5rpx;
  border-radius: 999rpx;
  transform-origin: 0 50%;
  background: linear-gradient(90deg, rgba(126, 140, 160, 0.12), rgba(126, 140, 160, 0.34));
}

.sketch-segment.current {
  background: linear-gradient(90deg, rgba(61, 74, 92, 0.2), rgba(61, 74, 92, 0.5));
}

.sketch-segment.done {
  opacity: 0.72;
}

.sketch-bend {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  margin-left: -4rpx;
  margin-top: -4rpx;
  border-radius: 999rpx;
  background: rgba(125, 138, 156, 0.18);
  box-shadow: 0 0 0 3rpx rgba(255, 255, 255, 0.75);
}

.sketch-bend.current {
  background: rgba(17, 24, 39, 0.32);
}

.sketch-point {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  margin-left: -9rpx;
  margin-top: -9rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid rgba(17, 24, 39, 0.12);
  box-shadow: 0 0 0 5rpx rgba(255, 255, 255, 0.88);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.sketch-point.done {
  opacity: 0.8;
}

.sketch-point.current {
  width: 26rpx;
  height: 26rpx;
  margin-left: -13rpx;
  margin-top: -13rpx;
  background: #111827;
  border-color: #111827;
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.92);
}

.sketch-point.food {
  background: rgba(255, 247, 237, 0.98);
}

.sketch-point.hotel {
  background: rgba(245, 243, 255, 0.98);
}

.sketch-point.spot {
  background: rgba(255, 251, 235, 0.98);
}

.sketch-point-num {
  font-size: 12rpx;
  font-weight: 800;
  color: #111827;
}

.sketch-point.current .sketch-point-num {
  color: #ffffff;
  font-size: 14rpx;
}

.timeline-main {
  position: relative;
  padding-left: 20rpx;
  border-left: 2rpx solid rgba(17, 24, 39, 0.08);
}

.timeline.hardcore .timeline-main {
  border-left-color: rgba(17, 24, 39, 0.18);
}

.timeline-dot {
  position: absolute;
  top: 6rpx;
  left: -10rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #98a1af;
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.9);
}

.timeline-dot.food {
  background: #c2410c;
}

.timeline-dot.hotel {
  background: #6d28d9;
}

.timeline-dot.spot {
  background: #1f2937;
}

.timeline-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.timeline .muted {
  line-height: 1.42;
}

.timeline-reason {
  margin-top: 4rpx;
}

.timeline-chips {
  margin-top: 10rpx;
}
